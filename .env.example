# ------------------------------------------------------------------
# SwasthyaTriage AI — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth ---
JWT_SECRET=generate-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Comma-separated list (dev only). Production must use HTTPS-only cookies.
COOKIE_SECURE=false

# --- Google Gemini ---
# Used by: conversation / extraction / summary / follow-up / OCR fallback / Live voice
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- Telephony: mock | videosdk ---
TELEPHONY_PROVIDER=mock
VIDEOSDK_AUTH_TOKEN=
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET_KEY=
# Optional SIP/PSTN configuration (only needed for real phone calls)
VIDEOSDK_SIP_FROM=
VIDEOSDK_ROUTING_RULE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Secret used to authenticate provider call-status webhooks (HMAC-SHA256)
TELEPHONY_WEBHOOK_SECRET=
# Supplementary contact Sonam surfaces on red-flag emergencies (National 112 is always advised)
EMERGENCY_ESCALATION_CONTACT=6370659934

# --- SnapServe AI Lead Capture ---
VITE_SNAPSERVE_TOKEN=your_snapserve_token_here

# --- CORS / app ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# --- Storage ---
MAX_UPLOAD_MB=20

# --- Transactional Email System (Gmail SMTP | Resend | Mock) ---
EMAIL_PROVIDER=gmail
APP_BASE_URL=http://localhost:5173
EMAIL_DELIVERY_MODE=mock
EMAIL_REQUEST_TIMEOUT_SECONDS=10
EMAIL_REPLY_TO=support@swasthyatriage.gov.in

# Gmail SMTP Provider (Production default, zero domain verification required)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=SwasthyaFlow AI
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Resend Provider (Requires verified custom domain)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME=SwasthyaFlow AI
RESEND_REPLY_TO_EMAIL=support@swasthyatriage.gov.in
RESEND_WEBHOOK_SECRET=

